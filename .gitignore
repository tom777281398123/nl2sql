# 项目相关目录
resources/doc/
output/
logs/
docker/data/
docker/bak/
# 本地 embedding 模型(~1.2G,不入库)
docker/models/
# run.sh 运行时 PID 目录
.run/

# IDE 配置文件（关键！解决你 .idea 报错）
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/

# Python 缓存文件（关键！解决 __pycache__ 报错）
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
.pytest_cache/

# 环境文件
.venv/
venv/
node_modules/

# 其他临时文件
*.log
*.tmp
.DS_Store
# macOS AppleDouble 垃圾文件
._*
Thumbs.db
*.lock
